@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>AutoChord</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/meyer-reset/2.0/reset.min.css" />
</head>

<body>
    <div class="desktop">
        <div class="content-wrapper">
            <!-- Глобальный хедер -->
            <div class="global-header">
                <div class="logo" role="img" aria-label="Логотип" onclick="resetUpload()" style="cursor: pointer;">
                    <img src="~/img/group-4.svg" alt="Логотип" class="logo-img" />
                </div>
                <div class="user-controls">
                    <img src="~/img/vector-15.svg" alt="" class="user-icon" />
                    <button class="profile-btn" aria-label="Профиль пользователя">
                        <img src="~/img/ellipse-4.svg" alt="Профиль" class="profile-img" />
                    </button>
                </div>
            </div>

            <div class="dark-rectangle @(string.IsNullOrEmpty(Model.ChordsOutput) ? "" : "results-page")">
                @if (string.IsNullOrEmpty(Model.ChordsOutput))
                {
                    <!-- ЗАГРУЗОЧНАЯ СТРАНИЦА -->
                    <div class="upload-area">
                        <div class="upload-icon-wrapper">
                            <img src="~/img/group-9.svg" alt="Загрузка" class="cloud-with-arrow" />
                        </div>
                        <p class="drag-text">Перетащите сюда свой аудиофайл</p>
                        <p class="or-text">или</p>
                        <form method="post" enctype="multipart/form-data" asp-page-handler="AddFile" class="upload-form" id="uploadForm">
                            <label class="file-button" for="file-input">
                                <span class="button-text">Выберите файл</span>
                            </label>
                            <input id="file-input" class="file-input-hidden" type="file" name="LastUploadedFile"
                                   accept=".mp3, .ogg, .wav, .flac, .aac, .m4a, audio/mpeg, audio/ogg, audio/wav" 
                                   onchange="document.getElementById('uploadForm').submit();" />
                        </form>
                    </div>
                    <p class="formats-hint">Поддерживаются WAV, MP3, FLAC, AAC, OGG, M4A</p>

                    @if (!string.IsNullOrEmpty(Model.UploadedFileUrl))
                    {
                        <div class="analyze-wrapper">
                            <form method="post" asp-page-handler="RecognizeChords">
                                <input type="hidden" name="UploadedFileUrl" value="@Model.UploadedFileUrl" />
                                <button class="analyze-btn" type="submit">
                                    <span class="analyze-text">Анализировать аккорды</span>
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="analyze-wrapper disabled">
                            <button class="analyze-btn" type="button" disabled>
                                <span class="analyze-text">Анализировать аккорды</span>
                            </button>
                        </div>
                    }
                }
                else
                {
                    <!-- СТРАНИЦА РЕЗУЛЬТАТОВ -->
                    <div class="results-layout">
                        <!-- Декоративный фон -->
                        <img class="decor-bg" src="~/img/group-11.png" alt="" aria-hidden="true" />

                        <!-- Верхняя часть: карточка артиста и правая панель -->
                        <div class="top-section">
                            <!-- Artist Card -->
                            <div class="artist-card">
                                <div class="artist-card-bg"></div>
                                <img class="album-art" src="~/img/content.png" alt="Album artwork" />
                                <h2 class="song-title">Sodus</h2>
                                <p class="artist-name">Cemeteries</p>
                                <button class="add-chord-btn" type="button">
                                    <div class="plus-h"></div>
                                    <div class="plus-v"></div>
                                </button>
                            </div>

                            <!-- Правая панель -->
                            <div class="right-panel">
                                <!-- Аккорды с SVG из папки chords -->
                                <div class="accords-section">
                                    <div class="chord-card current-card active">
                                        <img class="chord-svg" id="current-chord-svg" src="~/img/chords/G.svg" alt="Current chord" />
                                    </div>
                                    <div class="chord-card next-card">
                                        <img class="chord-svg" id="next-chord-svg" src="~/img/chords/Em.svg" alt="Next chord" />
                                    </div>
                                    <div class="chord-card after-next-card">
                                        <img class="chord-svg" id="after-next-chord-svg" src="~/img/chords/C.svg" alt="After next chord" />
                                    </div>
                                </div>

                                <!-- Timeline -->
                                <div class="timeline-container">
                                    <div class="timeline-bg"></div>
                                    <div class="timeline-inner-frame"></div>
                                    <div class="timeline-line-top"></div>
                                    <div class="timeline-line-middle"></div>
                                    <div class="timeline-viewport" id="timeline-viewport">
                                        <div class="timeline-scroll" id="timeline-scroll"></div>
                                    </div>
                                    <div class="timeline-current-line" id="timeline-current-line"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Audio Player -->
                        <div class="player" role="region" aria-label="Audio Player">
                            <div class="player-controls-line">
                                <div class="speed-control" id="speed-control">
                                    <span class="speed-value" id="speed-value">1</span>
                                    <span class="speed-x">x</span>
                                </div>
                                <img class="skip-back-btn" src="~/img/skip-back.svg" alt="Skip back" />
                                <img class="play-pause-btn" id="play-pause-btn" src="~/img/play.svg" alt="Play" />
                                <img class="skip-forward-btn" src="~/img/skip-forward.svg" alt="Skip forward" />
                                <img class="repeat-icon" src="~/img/repeat.svg" alt="Repeat" />
                            </div>

                            <div class="progress-wrapper">
                                <div class="player-progress-area">
                                    <span class="current-time" id="current-time">0:00</span>
                                    <div class="progress-bar-container" id="progress-container">
                                        <div class="progress-bg-line"></div>
                                        <div class="progress-fill-line" id="progress-fill"></div>
                                        <div class="progress-handle" id="progress-handle"></div>
                                    </div>
                                    <span class="total-time" id="total-time">0:00</span>
                                </div>
                            </div>

                            <div class="player-right-controls">
                                <div class="volume-control">
                                    <img src="~/img/vector-9.svg" alt="Volume" class="volume-icon" />
                                    <div class="volume-slider">
                                        <div class="volume-bg-line"></div>
                                        <div class="volume-fill-line" id="volume-fill"></div>
                                        <div class="volume-handle" id="volume-handle"></div>
                                    </div>
                                </div>
                                <img class="fullscreen-icon" src="~/img/vector-10.svg" alt="Fullscreen" />
                            </div>
                        </div>
                    </div>

                    <audio id="audio-player" style="display: none;" preload="auto">
                        <source src="@Model.UploadedFileUrl" type="audio/mpeg" />
                    </audio>

                    <script>
                        const chordNames = @Html.Raw(Json.Serialize(Model.ChordsOutput.Split(" ")));
                        const chordTimes = @Html.Raw(Json.Serialize(Model.ChordsIntervals.Select(t => t / 1000.0)));
                        const audio = document.getElementById("audio-player");
                        
                        const playPauseBtn = document.getElementById("play-pause-btn");
                        const currentTimeSpan = document.getElementById("current-time");
                        const totalTimeSpan = document.getElementById("total-time");
                        const progressFill = document.getElementById("progress-fill");
                        const progressHandle = document.getElementById("progress-handle");
                        const progressContainer = document.getElementById("progress-container");
                        const speedControl = document.getElementById("speed-control");
                        const speedValueSpan = document.getElementById("speed-value");
                        const volumeFill = document.getElementById("volume-fill");
                        const volumeHandle = document.getElementById("volume-handle");
                        const volumeSlider = document.querySelector(".volume-slider");
                        
                        // SVG аккордов
                        const currentChordSvg = document.getElementById("current-chord-svg");
                        const nextChordSvg = document.getElementById("next-chord-svg");
                        const afterNextChordSvg = document.getElementById("after-next-chord-svg");
                        
                        // Timeline элементы
                        const timelineScroll = document.getElementById("timeline-scroll");
                        const timelineViewport = document.getElementById("timeline-viewport");
                        const timelineCurrentLine = document.getElementById("timeline-current-line");
                        
                        let isDragging = false;
                        let isDraggingVolume = false;
                        let currentSpeed = 1;
                        let currentVolume = 0.7;
                        let currentScrollLeft = 0;
                        let isScrolling = false;
                        
                        const PIXELS_PER_SECOND = 120;
                        const VISIBLE_SECONDS = 7;
                        
                        function getChordFileName(chordName) {
                            if (!chordName || chordName === "—") return "Empty.svg";
                            return chordName + ".svg";
                        }
                        
                        function updateChordsDisplay(currentTime) {
                            let currentIndex = 0;
                            for (let i = 0; i < chordTimes.length; i++) {
                                if (chordTimes[i] <= currentTime) {
                                    currentIndex = i;
                                } else {
                                    break;
                                }
                            }
                            
                            // Текущий аккорд (слева)
                            const currentChord = chordNames[currentIndex];
                            if (currentChord && currentChordSvg) {
                                currentChordSvg.src = "/img/chords/" + getChordFileName(currentChord);
                            }
                            
                            // Следующий аккорд (по центру)
                            const nextChord = (currentIndex + 1 < chordTimes.length) ? chordNames[currentIndex + 1] : null;
                            if (nextChord && nextChordSvg) {
                                nextChordSvg.src = "/img/chords/" + getChordFileName(nextChord);
                            } else if (nextChordSvg) {
                                nextChordSvg.src = "/img/chords/Empty.svg";
                            }
                            
                            // После следующего (третий аккорд) (справа)
                            const afterNextChord = (currentIndex + 2 < chordTimes.length) ? chordNames[currentIndex + 2] : null;
                            if (afterNextChord && afterNextChordSvg) {
                                afterNextChordSvg.src = "/img/chords/" + getChordFileName(afterNextChord);
                            } else if (afterNextChordSvg) {
                                afterNextChordSvg.src = "/img/chords/Empty.svg";
                            }
                        }
                        
                        function formatTime(seconds) {
                            if (isNaN(seconds)) return "0:00";
                            const mins = Math.floor(seconds / 60);
                            const secs = Math.floor(seconds % 60);
                            return mins + ":" + secs.toString().padStart(2, '0');
                        }
                        
                        function updateProgressBar() {
                            if (audio.duration && !isDragging) {
                                const percent = (audio.currentTime / audio.duration) * 100;
                                progressFill.style.width = percent + "%";
                                progressHandle.style.left = percent + "%";
                            }
                        }
                        
                        function updateVolumeBar() {
                            if (volumeFill && volumeHandle) {
                                const percent = currentVolume * 100;
                                volumeFill.style.width = percent + "%";
                                volumeHandle.style.left = percent + "%";
                            }
                        }
                        
                        function buildTimeline() {
                            if (!timelineScroll || !audio.duration) return;
                            
                            const totalSeconds = audio.duration;
                            const totalWidth = totalSeconds * PIXELS_PER_SECOND;
                            timelineScroll.style.width = totalWidth + "px";
                            timelineScroll.style.position = "relative";
                            timelineScroll.style.height = "168px";
                            
                            timelineScroll.innerHTML = "";
                            
                            // Секундные отметки
                            for (let sec = 0; sec <= Math.ceil(totalSeconds); sec++) {
                                const xPos = sec * PIXELS_PER_SECOND;
                                
                                const markContainer = document.createElement("div");
                                markContainer.className = "timeline-second-mark";
                                markContainer.style.position = "absolute";
                                markContainer.style.left = xPos + "px";
                                markContainer.style.top = "0";
                                markContainer.style.display = "flex";
                                markContainer.style.flexDirection = "column";
                                markContainer.style.alignItems = "center";
                                
                                const timeLabel = document.createElement("span");
                                timeLabel.className = "timeline-time-label";
                                timeLabel.innerText = formatTime(sec);
                                timeLabel.style.marginTop = "8px";
                                markContainer.appendChild(timeLabel);
                                
                                const tick = document.createElement("div");
                                tick.className = "timeline-time-tick";
                                markContainer.appendChild(tick);
                                
                                timelineScroll.appendChild(markContainer);
                            }
                            
                            // Точки аккордов на средней линии
                            for (let i = 0; i < chordTimes.length; i++) {
                                const chordSec = chordTimes[i];
                                const xPos = chordSec * PIXELS_PER_SECOND;
                                
                                const dot = document.createElement("div");
                                dot.className = "timeline-chord-dot";
                                dot.style.position = "absolute";
                                dot.style.left = xPos + "px";
                                dot.style.top = "100px";
                                dot.setAttribute("data-time", chordSec);
                                dot.setAttribute("data-chord", chordNames[i]);
                                
                                dot.addEventListener('click', (function(time) {
                                    return function() {
                                        audio.currentTime = time;
                                        currentTimeSpan.innerText = formatTime(audio.currentTime);
                                        updateProgressBar();
                                        updateTimelineScroll();
                                        updateChordsDisplay(audio.currentTime);
                                    };
                                })(chordSec));
                                
                                timelineScroll.appendChild(dot);
                                
                                // Название аккорда над точкой
                                const chordName = document.createElement("span");
                                chordName.className = "timeline-chord-name";
                                chordName.innerText = chordNames[i];
                                chordName.style.position = "absolute";
                                chordName.style.left = xPos + "px";
                                chordName.style.top = "45px";
                                timelineScroll.appendChild(chordName);
                            }
                        }
                        
                        function updateTimelineScroll() {
                            if (!timelineViewport || !audio.duration) return;
                            
                            const currentSec = audio.currentTime;
                            const scrollCenter = currentSec * PIXELS_PER_SECOND;
                            const viewportWidth = timelineViewport.clientWidth;
                            
                            let scrollLeft = scrollCenter - viewportWidth / 2;
                            scrollLeft = Math.max(0, Math.min(scrollLeft, timelineScroll.scrollWidth - viewportWidth));
                            
                            timelineViewport.scrollLeft = scrollLeft;
                            currentScrollLeft = scrollLeft;
                            
                            const lineLeft = scrollCenter - scrollLeft;
                            if (lineLeft >= 0 && lineLeft <= viewportWidth) {
                                timelineCurrentLine.style.display = "block";
                                timelineCurrentLine.style.left = (29 + lineLeft) + "px";
                            } else {
                                timelineCurrentLine.style.display = "none";
                            }
                        }
                        
                        function setPositionFromTimeline(clientX) {
                            if (!timelineViewport || !audio.duration) return;
                            
                            const rect = timelineViewport.getBoundingClientRect();
                            const clickX = clientX - rect.left;
                            const absoluteX = timelineViewport.scrollLeft + clickX;
                            const newSec = absoluteX / PIXELS_PER_SECOND;
                            const newTime = Math.max(0, Math.min(newSec, audio.duration));
                            
                            audio.currentTime = newTime;
                            currentTimeSpan.innerText = formatTime(audio.currentTime);
                            updateProgressBar();
                            updateTimelineScroll();
                            updateChordsDisplay(audio.currentTime);
                        }
                        
                        function setPositionFromEvent(clientX) {
                            if (!audio.duration) return;
                            const rect = progressContainer.getBoundingClientRect();
                            let x = clientX - rect.left;
                            x = Math.max(0, Math.min(x, rect.width));
                            const percent = x / rect.width;
                            const newTime = percent * audio.duration;
                            audio.currentTime = newTime;
                            currentTimeSpan.innerText = formatTime(audio.currentTime);
                            updateProgressBar();
                            updateTimelineScroll();
                            updateChordsDisplay(audio.currentTime);
                        }
                        
                        function setVolumeFromEvent(clientX) {
                            if (!volumeSlider) return;
                            const rect = volumeSlider.getBoundingClientRect();
                            let x = clientX - rect.left;
                            x = Math.max(0, Math.min(x, rect.width));
                            const percent = x / rect.width;
                            currentVolume = percent;
                            audio.volume = currentVolume;
                            updateVolumeBar();
                        }
                        
                        if (timelineViewport) {
                            timelineViewport.addEventListener('scroll', function() {
                                if (!isScrolling) {
                                    currentScrollLeft = timelineViewport.scrollLeft;
                                    const currentSec = audio.currentTime;
                                    const currentX = currentSec * PIXELS_PER_SECOND;
                                    const lineLeft = currentX - currentScrollLeft;
                                    const viewportWidth = timelineViewport.clientWidth;
                                    
                                    if (lineLeft >= 0 && lineLeft <= viewportWidth) {
                                        timelineCurrentLine.style.display = "block";
                                        timelineCurrentLine.style.left = (29 + lineLeft) + "px";
                                    } else {
                                        timelineCurrentLine.style.display = "none";
                                    }
                                }
                            });
                            
                            timelineViewport.addEventListener('click', function(e) {
                                setPositionFromTimeline(e.clientX);
                            });
                        }
                        
                        if (progressHandle) {
                            progressHandle.addEventListener('mousedown', function(e) {
                                isDragging = true;
                                e.preventDefault();
                                e.stopPropagation();
                            });
                        }
                        
                        if (progressContainer) {
                            progressContainer.addEventListener('click', function(e) {
                                setPositionFromEvent(e.clientX);
                            });
                        }
                        
                        if (volumeHandle) {
                            volumeHandle.addEventListener('mousedown', function(e) {
                                isDraggingVolume = true;
                                e.preventDefault();
                                e.stopPropagation();
                            });
                        }
                        
                        if (volumeSlider) {
                            volumeSlider.addEventListener('click', function(e) {
                                setVolumeFromEvent(e.clientX);
                            });
                        }
                        
                        window.addEventListener('mousemove', function(e) {
                            if (isDragging) {
                                setPositionFromEvent(e.clientX);
                            }
                            if (isDraggingVolume) {
                                setVolumeFromEvent(e.clientX);
                            }
                        });
                        
                        window.addEventListener('mouseup', function() {
                            isDragging = false;
                            isDraggingVolume = false;
                        });
                        
                        if (playPauseBtn) {
                            playPauseBtn.addEventListener('click', function() {
                                if (audio.paused) {
                                    audio.play();
                                    playPauseBtn.src = "/img/pause.svg";
                                } else {
                                    audio.pause();
                                    playPauseBtn.src = "/img/play.svg";
                                }
                            });
                        }
                        
                        if (speedControl) {
                            speedControl.addEventListener('click', function() {
                                const speeds = [1, 1.5, 2, 0.5];
                                const currentIndex = speeds.indexOf(currentSpeed);
                                currentSpeed = speeds[(currentIndex + 1) % speeds.length];
                                audio.playbackRate = currentSpeed;
                                speedValueSpan.innerText = currentSpeed;
                            });
                        }
                        
                        audio.volume = currentVolume;
                        updateVolumeBar();
                        
                        if (audio) {
                            audio.addEventListener('loadedmetadata', function() {
                                totalTimeSpan.innerText = formatTime(audio.duration);
                                currentTimeSpan.innerText = formatTime(0);
                                updateProgressBar();
                                buildTimeline();
                                updateTimelineScroll();
                                updateChordsDisplay(0);
                            });
                            
                            audio.addEventListener('timeupdate', function() {
                                if (!isDragging) {
                                    currentTimeSpan.innerText = formatTime(audio.currentTime);
                                    updateProgressBar();
                                    updateTimelineScroll();
                                    updateChordsDisplay(audio.currentTime);
                                }
                            });
                            
                            audio.addEventListener('play', function() {
                                playPauseBtn.src = "/img/pause.svg";
                            });
                            
                            audio.addEventListener('pause', function() {
                                playPauseBtn.src = "/img/play.svg";
                            });
                        }
                        
                        function resetUpload() { 
                            window.location.href = window.location.pathname; 
                        }
                    </script>
                }
            </div>
        </div>
    </div>
</body>
</html>